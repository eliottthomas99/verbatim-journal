# Copy to .env (never commit .env) and fill in.

# Required. The app must send this token; the server refuses to start without it.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
VERBATIM_API_TOKEN=change-me

# Any OpenAI-compatible chat endpoint running on this computer.
VERBATIM_LLM_URL=http://127.0.0.1:8080/v1/chat/completions
# The name your model server knows the model by.
VERBATIM_LLM_MODEL=local-model

# Where transcripts, summaries and the search index are stored.
# VERBATIM_DATA_DIR=./data

# Most characters of text sent to the model at once. About 3 characters per token:
# 24000 fits a 16K context window. Lower it for a smaller window.
# VERBATIM_CONTEXT_CHARS=24000

# Once the embedding model is downloaded, forbid any further Hugging Face access.
# HF_HUB_OFFLINE=1
