# JNI looks up these class/method names; renaming/removing them breaks speech.
-keep class com.k2fsa.sherpa.onnx.** { *; }
-keep class app.verbatim.voice.PiperVoices$ChunkSink { *; }

# Gson reads these field names and generic arguments through reflection.
-keepattributes Signature,*Annotation*
-keep class app.verbatim.network.** { *; }
-keep class app.verbatim.asr.TranscriptSegment { *; }
-keep class com.google.gson.reflect.TypeToken { *; }
-keep class * extends com.google.gson.reflect.TypeToken { *; }

# Retrofit 2.9 reflects the generic suspend-function continuation/response types.
# Full-mode R8 drops their signatures unless those generic declarations survive.
-keep interface kotlin.coroutines.Continuation { *; }
-keep class retrofit2.Response { *; }
-keep interface retrofit2.Call { *; }
